# GEMINI_API_KEY: Required by /api/discover to generate live, AI-powered
# opportunities with Gemini. Without it, the Discovery Scan silently falls
# back to a small set of static example opportunities (marked "Example
# (offline)" in the UI). Get a free key at https://aistudio.google.com/apikey
# — no credit card required. Inside AI Studio's own hosting this is injected
# automatically via the Secrets panel; on Vercel or elsewhere, set it with
# `vercel env add GEMINI_API_KEY`.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
